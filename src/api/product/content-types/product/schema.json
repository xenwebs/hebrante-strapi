      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "discount_percent": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0,
      "min": 0,
      "max": 100
