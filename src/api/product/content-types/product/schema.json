          "localized": true
        }
      }
    },
    "feature2_en": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "feature3": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "feature3_en": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
